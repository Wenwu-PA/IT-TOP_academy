   "outputs": [],
   "source": [
    "stack = []\n",
    "\n",
    "with open(\"input.dat\", \"r\", encoding=\"utf-8\") as file:\n",
    "    for line in file:\n",
    "        for item in line.split():\n",
    "            stack.append(item)\n",
    "\n",
    "with open(\"output.dat\", \"w\", encoding=\"utf-8\") as file:\n",
    "    while stack:\n",
    "        file.write(stack.pop() + \"\\n\")"
   ]
  }
 ],
